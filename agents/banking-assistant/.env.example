# Client ids, secrets and the LLM gateway URL are written to .env.generated by
# the provisioners and loaded on top of this file -- do not set them here.
# =============================================================================
# AI Banking Agent configuration
#
# AGENT_IDENTITY__*  -- WSO2 Agent Identity + OAuth app config, used for BOTH:
#                          1. this agent proving its own identity (self-auth), and
#                          2. delegating on behalf of an end user (RFC 8693 token
#                             exchange, subject = caller's token, actor = this agent).
#                        See identity/self_auth.py / identity/token_exchange.py.
# AGENT_MCP__*       -- the MCP server this agent calls as an MCP client.
# AGENT_LLM__*        -- the model powering the conversational loop (pydantic-ai).
# AGENT_FRONTEND__*  -- the browser origin allowed to call /chat (CORS only).
# =============================================================================

# --- AGENT_IDENTITY__*: WSO2 Agent Identity ---

# authorize_endpoint/token_endpoint are derived from this at runtime (standard
# OIDC discovery fields); authn_endpoint is WSO2-native and has no discovery
# equivalent, so it stays explicit below.
AGENT_IDENTITY__DISCOVERY_URL=http://thunder.amp.localhost:8080/.well-known/openid-configuration

# OAuth application ("clientID"/"clientSecret") registered for this agent.
AGENT_IDENTITY__CLIENT_ID=change-me
AGENT_IDENTITY__CLIENT_SECRET=change-me

# Agent Identity credentials ("agentID"/"agentSecret") -- submitted as
# username/password to the native /authn API during self-auth ONLY. Never
# used for the on-behalf-of-user leg; the end user authenticates as
# themselves, directly with the IdP.
AGENT_IDENTITY__AGENT_ID=change-me
AGENT_IDENTITY__AGENT_SECRET=change-me


# This agent's own OAuth callback -- must be registered byte-identically on
# the WSO2 app.
AGENT_IDENTITY__REDIRECT_URI=http://localhost:18020/oauth/callback

# Scopes on the agent's own actor_token. A delegated exchange is bounded by
# BOTH the subject's and the actor's grants, so this must cover everything the
# agent will act on the user's behalf for.
AGENT_IDENTITY__SELF_SCOPE=openid apex:mcp-accounts:read apex:mcp-transactions:read apex:mcp-payees:read apex:mcp-payments:write


# --- AGENT_MCP__*: the MCP server ---
AGENT_MCP__SERVER_URL=http://localhost:18010
# API resource identifier of the MCP server -- the `audience` of the delegated
# token. Must be a registered audience on this agent's application.
AGENT_MCP__AUDIENCE=urn:apex
# Scopes requested on the delegated token. The exchange narrows but never
# widens, so these must already be present on the caller's token.
AGENT_MCP__SCOPES='openid apex:mcp-accounts:read apex:mcp-transactions:read apex:mcp-payees:read apex:mcp-payments:write apex:bank:accounts:read apex:bank:accounts:balances:read apex:bank:accounts:transactions:read apex:bank:payees:read apex:bank:payments:write'

# --- AGENT_LLM__*: the conversational model ---
AGENT_LLM__ANTHROPIC_API_KEY=change-me
AGENT_LLM__MODEL=claude-opus-5
# Optional. Unset means api.anthropic.com. Point it at a gateway (an APIM proxy
# that meters and audits model calls) or any Anthropic-compatible endpoint; the
# key above is then whatever that endpoint authenticates with.
# AGENT_LLM__BASE_URL=https://gateway.example.com/anthropic
# Header the gateway reads the key from, when it is not x-api-key:
# AGENT_LLM__API_KEY_HEADER=API-Key

# --- AGENT_FRONTEND__*: browser origin allowed to call /chat (CORS) ---
AGENT_FRONTEND__ORIGIN=http://portal.apex.localhost

# --- Runtime -- AGENT_ENV also selects which env file loads (development ->
# .env, staging -> .env.staging, production -> .env.production) ---
# INFO by default; DEBUG also shows the OTLP exporter's own HTTP calls.
AGENT_LOG_LEVEL=INFO

AGENT_ENV=development
AGENT_HOST=0.0.0.0
AGENT_PORT=18020

# Put prompts, replies and tool arguments on the trace spans. That is what
# makes a trace answer 'what did it decide and why', and it means chat
# content reaches the collector -- set false where that is not wanted.
AGENT_TRACE_CONTENT=true

# --- AGENT_SECURITY__*: passkey enrolment, relayed for the portal ---
# FLOW_SECRET is written to .env.generated by thunder-init. The browser cannot
# hold it, which is why enrolment is relayed through this service at all.
AGENT_SECURITY__APPLICATION_ID='apex-security-client'
# What an inbound customer token must carry to be believed. Enrolment writes a
# new authentication factor onto the account it names, so unlike /chat this
# token is verified rather than forwarded.
AGENT_SECURITY__AUDIENCE='urn:apex'
AGENT_SECURITY__PORTAL_CLIENT_ID='apex-portal-client'
# How recently the customer must have signed in to add a passkey.
AGENT_SECURITY__MAX_AUTH_AGE_SECONDS=300
