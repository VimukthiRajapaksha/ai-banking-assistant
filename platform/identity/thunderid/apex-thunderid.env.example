# Values for apex-thunderid-bundle.yaml. Upload alongside it on the console's
# Import Configuration page. Secrets are freshly generated; the services need
# the same values, so keep this file (it is gitignored).

# Where the portals will be served. HTTPS: passkeys require it off localhost.
APEX_PORTAL_ORIGIN=
APEX_CONSENT_PORTAL_ORIGIN=
# The bank portal's host, exactly -- no scheme, no port. Passkeys bind to it.
APEX_PASSKEY_RP_ID=

APEX_SECURITY_FLOW_SECRET=
APEX_MCP_FLOW_SECRET=
APEX_MCP_CLIENT_SECRET=
APEX_CONSENT_PORTAL_CLIENT_SECRET=
APEX_AGENT_IDENTITY_SECRET=
APEX_USER_PASSWORD=
