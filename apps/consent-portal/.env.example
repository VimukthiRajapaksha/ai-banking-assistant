# Copy to .env. Every value is read by the server at run time -- none reaches
# the browser -- so one build serves every environment.

# Where this portal is served. Sign-in returns to <APP__BASE_URL>/auth/callback
# and sign-out to <APP__BASE_URL>/; both must be registered, byte-identical, on
# the ThunderID application.
APP__BASE_URL=http://localhost:18060

# --- AUTH__*: customer sign-in with ThunderID ---
# The customer is already signed in to the bank portal through the same
# ThunderID sign-in flow (apex-login), so this redirect completes without a
# prompt.
AUTH__BASE_URL=https://<thunderid-host>
AUTH__CLIENT_ID=apex-consent-portal-client
# APEX_CONSENT_PORTAL_CLIENT_SECRET from platform/identity/thunderid.
AUTH__CLIENT_SECRET=
# The application's defaultAudience; the access token is rejected otherwise.
AUTH__AUDIENCE=urn:apex:consent-portal
AUTH__SCOPES="openid profile email portal:consents:read:self portal:consents:write:self"

# Encrypts the session cookie. At least 32 characters: openssl rand -base64 32
SESSION__SECRET=

# --- ASGARDEO__*: the consent store ---
# Asgardeo's Consent Management API v2, called with client credentials. The
# secret never leaves the server; every call is scoped to the signed-in
# customer's ThunderID subject.
ASGARDEO__BASE_URL=https://api.asgardeo.io/t/wso2solutionsbfsi
ASGARDEO__CLIENT_ID=
ASGARDEO__CLIENT_SECRET=
# Least privilege: read consents and purposes, approve/reject/revoke consents.
ASGARDEO__SCOPES="internal_consent_mgt_consent_view internal_consent_mgt_consent_update internal_consent_mgt_purpose_view"

# Optional: the bank portal, for the "Back to banking" link. Hidden when unset.
BANK_PORTAL__URL=
