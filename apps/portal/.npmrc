# @wso2/oxygen-ui@0.13.1 pins peer react@19.2.3 exactly while the lockfile
# resolves react@19.3.0, and npm 10 refuses that. Set here rather than on the
# command line so every install honours it, including the `npm ci` the WSO2
# Developer Platform's React preset runs before the build command.
legacy-peer-deps=true
