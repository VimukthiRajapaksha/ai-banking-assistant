# Copy to .env. Every value here is deterministic -- the provisioners create the
# ThunderID application under these exact ids, so nothing needs pasting in.
VITE_AUTH__BASE_URL=http://thunder.amp.localhost:8080
VITE_AUTH__CLIENT_ID=apex-portal-client
VITE_AUTH__AFTER_SIGN_IN_URL=http://portal.apex.localhost/oauth/callback
VITE_AUTH__AFTER_SIGN_OUT_URL=http://portal.apex.localhost

# Full scope envelope: a delegated exchange can narrow but never widen, and
# ThunderID filters a token's scopes to the one resource server it names, so
# every scope any downstream hop needs -- the agent's, the MCP server's, the
# bank's -- must be granted here at sign-in or it can never appear again.
VITE_AUTH__LOGIN_SCOPES=openid profile email apex:agent:chat:read apex:agent:chat:write apex:bank:accounts:read apex:bank:accounts:balances:read apex:bank:accounts:transactions:read apex:bank:payees:read apex:bank:payments:write apex:mcp-accounts:read apex:mcp-transactions:read apex:mcp-payees:read apex:mcp-payments:write

# The resource indicator sent at sign-in. One resource server, one audience.
VITE_AUTH__AUDIENCE=urn:apex

# --- VITE_BANK_API__*: bank API calls via the APIM gateway ---
# Relative on purpose: Caddy serves the portal and forwards /bank-api to the
# WSO2 API Manager gateway, so the browser has no route to the bank except
# through it -- and same-origin means no CORS on this leg at all.
VITE_BANK_API__BASE_URL=/bank-api

# The agent's root URL; the app calls <base>/chat and <base>/security/passkey.
# Empty (as here) means the portal's own origin, where Caddy forwards both
# paths to the agent. On the WSO2 Developer Platform, set the agent's URL.
VITE_AGENT__BASE_URL=

# Consent portal, linked from the account menu. A link only -- this app
# never calls the consent API. Omit to hide the menu item.
VITE_CONSENT__PORTAL_URL=http://portal.consent.apex.localhost
