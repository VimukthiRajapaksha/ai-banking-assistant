# MCP_INBOUND_OAUTH__* -- verifies bearer tokens agents present to this server
MCP_INBOUND_OAUTH__DISCOVERY_URL=https://your-idp.example.com/.well-known/openid-configuration
# Audience of tokens presented TO this server: this server's own resource
# identifier (RFC 8707), which is its URL. Must equal RESOURCE_SERVER_URL below.
MCP_INBOUND_OAUTH__AUDIENCE=http://localhost:8000
MCP_INBOUND_OAUTH__REQUIRED_SCOPES=mcp:accounts:read
MCP_INBOUND_OAUTH__RESOURCE_SERVER_URL=https://mcp.example.com

# MCP_OUTBOUND_OAUTH__* -- this server's OAuth client for the bank (may be a different IdP/tenant)
MCP_OUTBOUND_OAUTH__DISCOVERY_URL=https://bank.example.com/.well-known/openid-configuration
MCP_OUTBOUND_OAUTH__CLIENT_ID=change-me
MCP_OUTBOUND_OAUTH__CLIENT_SECRET=change-me
MCP_OUTBOUND_OAUTH__REDIRECT_URI=http://localhost:18010/oauth/callback
MCP_OUTBOUND_OAUTH__SCOPE=accounts accounts:balances
# API resource identifier of the bank; the `audience` of the exchanged token.
MCP_OUTBOUND_OAUTH__AUDIENCE=https://apex.bank/api

# MCP_OUTBOUND_API__* -- the bank's resource APIs, called with the delegated token
MCP_OUTBOUND_API__BASE_URL=https://bank.example.com

# Runtime -- MCP_ENV also selects which env file loads (development -> .env,
# staging -> .env.staging, production -> .env.production); see settings.py
MCP_ENV=development
# --- MCP_CONSENT__*: the consent service (OpenFGC) ---
MCP_CONSENT__BASE_URL=http://localhost:18040/api/v1
MCP_CONSENT__ORG_ID=apex
MCP_CONSENT__GROUP_ID=apex-banking
MCP_CONSENT__ACCOUNT_ACCESS_PURPOSE_ID=01256222-61aa-4a4b-8df8-1bbad2490f1e
MCP_CONSENT__ACCOUNT_ACCESS_PURPOSE_NAME=account_information_access
MCP_CONSENT__ELEMENT_NAMESPACE=banking
MCP_CONSENT__VALIDITY_SECONDS=3600
MCP_CONSENT__PAYMENT_PURPOSE_ID=095e9541-88c2-4c8f-96e0-bb96c2953d35
MCP_CONSENT__PAYMENT_PURPOSE_NAME=payment_initiation
MCP_CONSENT__PAYMENT_VALIDITY_SECONDS=600

MCP_HOST=0.0.0.0
MCP_PORT=18010

# MCP_REQUEST_STATE__* -- seals the requestState handed to clients between
# elicitation rounds, which carries the pending consent id. Unset means a
# per-process key: pending consents die on restart and replicas cannot read
# each other's. Comma-separated for rotation; keys[0] seals, all unseal.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
MCP_REQUEST_STATE__KEYS=change-me-64-hex-chars
MCP_REQUEST_STATE__TTL_SECONDS=3600

# --- MCP_STEPUP__*: the payment step-up ceremony this server drives ---
# FLOW_SECRET is written to .env.generated by thunder-init and loaded on top of
# this file. It is a server credential -- anything holding it can start an
# authentication ceremony for any customer -- so it never reaches a browser.
MCP_STEPUP__BASE_URL='http://thunder.amp.localhost:8080'
MCP_STEPUP__APPLICATION_ID='apex-mcp-client'
# A password is the same factor the customer already used to sign in, so it is
# not a step-up. Payments require a passkey; enrolment is in the portal's
# Settings.
MCP_STEPUP__REQUIRE_PASSKEY=true
