# Same origin as the page. Caddy serves the SPA and forwards /api, /auth and
# /me to the BFF on this one hostname, and that is not cosmetic: the BFF's
# split-token cookies are host-only, so a cross-origin base URL means /me is
# sent WITHOUT them -- the SPA gets 401, restarts login, succeeds, and loops
# forever while the login itself was never the problem.
VITE_API_BASE_URL=http://portal.consent.apex.localhost
VITE_AUTH_ENABLED=true
VITE_AUTH_ACCESS_TOKEN_PART1_COOKIE=portal-at-p1
VITE_AUTH_REFRESH_TOKEN_PART1_COOKIE=portal-rt-p1
VITE_AUTH_ID_TOKEN_PART1_COOKIE=portal-id-p1
VITE_AUTH_ID_TOKEN_PART2_COOKIE=portal-id-p2
# Where an RP-initiated logout may redirect to -- ThunderID now, not Asgardeo.
VITE_AUTH_LOGOUT_ALLOWED_ORIGINS=http://thunder.amp.localhost:8080
