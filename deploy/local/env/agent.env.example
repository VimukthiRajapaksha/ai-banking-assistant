# Agent settings for the local stack. No secrets: client ids/secrets, the flow
# secret and the AMP LLM proxy URL/key are written to ../.env.generated by the
# init services and loaded on top of this file.
AGENT_IDENTITY__DISCOVERY_URL=http://thunder.amp.localhost:8080/.well-known/openid-configuration
AGENT_IDENTITY__REDIRECT_URI=http://localhost:18020/oauth/callback
AGENT_IDENTITY__SELF_SCOPE=openid

AGENT_MCP__AUDIENCE=urn:apex
AGENT_MCP__SCOPES=openid apex:mcp-accounts:read apex:mcp-transactions:read apex:mcp-payees:read apex:mcp-payments:write apex:bank:accounts:read apex:bank:accounts:balances:read apex:bank:accounts:transactions:read apex:bank:payees:read apex:bank:payments:write

AGENT_LLM__MODEL=claude-haiku-4-5-20251001

AGENT_FRONTEND__ORIGIN=http://portal.apex.localhost

AGENT_SECURITY__APPLICATION_ID=apex-security-client
AGENT_SECURITY__AUDIENCE=urn:apex
AGENT_SECURITY__PORTAL_CLIENT_ID=apex-portal-client
AGENT_SECURITY__MAX_AUTH_AGE_SECONDS=300

AGENT_LOG_LEVEL=INFO
AGENT_ENV=development
AGENT_PORT=18020
AGENT_TRACE_CONTENT=true
