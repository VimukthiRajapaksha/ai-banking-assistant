# MCP server settings for the local stack. No secrets: the outbound client
# credentials, the step-up flow secret, the consent purpose ids and the APIM
# gateway URL are written to ../.env.generated by the init services.
MCP_INBOUND_OAUTH__DISCOVERY_URL=http://thunder.amp.localhost:8080/.well-known/openid-configuration
MCP_INBOUND_OAUTH__AUDIENCE=urn:apex
MCP_INBOUND_OAUTH__REQUIRED_SCOPES=
MCP_INBOUND_OAUTH__RESOURCE_SERVER_URL=http://mcp.apex.localhost

MCP_OUTBOUND_OAUTH__DISCOVERY_URL=http://thunder.amp.localhost:8080/.well-known/openid-configuration
MCP_OUTBOUND_OAUTH__REDIRECT_URI=http://localhost:18010/oauth/callback
MCP_OUTBOUND_OAUTH__SCOPE=accounts accounts:balances
MCP_OUTBOUND_OAUTH__AUDIENCE=urn:apex

MCP_CONSENT__VALIDITY_SECONDS=3600
MCP_CONSENT__PAYMENT_VALIDITY_SECONDS=600

# Unset: a per-process key, so a consent form left open across a restart of
# this container has to be answered again. Set a 64-hex-char key to keep them.
MCP_REQUEST_STATE__KEYS=
MCP_REQUEST_STATE__TTL_SECONDS=3600

MCP_STEPUP__BASE_URL=http://thunder.amp.localhost:8080
MCP_STEPUP__APPLICATION_ID=apex-mcp-client
MCP_STEPUP__REQUIRE_PASSKEY=true

MCP_ENV=development
MCP_PORT=18010
