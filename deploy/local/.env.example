# Inputs to provisioning. Everything else is generated into .env.generated by
# the init services -- do not hand-edit that file.
#
# THUNDER_*: the one credential that cannot be created by a script. An
# application cannot grant itself the role it needs, and ThunderID closes every
# self-service route (DCR is permission-gated, there is no password grant, and
# unauthenticated writes are refused). See deploy/local/README.md, Step 1.
THUNDER_BASE_URL=http://thunder.amp.localhost:8080
THUNDER_CLIENT_ID=<from README Step 1>
THUNDER_CLIENT_SECRET=<from README Step 1>

# The Agent Management Platform's API.
AMP_BASE_URL=http://host.docker.internal:9000

# Configured on the LLM provider and never exported: the agent receives a
# gateway-issued key for a proxy URL instead, so this credential stays on the
# platform.
ANTHROPIC_API_KEY=<your Anthropic key>

# The customer account the provisioner creates (alex@apexbank.com).
# Mixed case, a digit and a symbol.
APEX_USER_PASSWORD=<choose a password>

# NPI masking guardrail on the agent's AMP LLM proxy: enforce (default) | monitor | off.
# Needs the custom AMP gateway from gateway-policies/; skipped on a stock one.
# Rotating ANTHROPIC_API_KEY above is picked up on the next `scripts/start.sh`.
AMP_NPI_GUARDRAIL=enforce

# Trace sampling for the agent and MCP server (head sampling, client side).
# Fraction of chats whose traces reach AMP: 1.0 = all, 0.1 = ~10%. A dropped
# trace is gone for good -- not searchable, not seen by evaluation monitors.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# Token budget for the agent on its AMP LLM proxy: total tokens per window,
# "<count>/<duration>[,...]", or off. Over budget answers 429 until it resets.
AMP_TOKEN_LIMITS=60000/1m,1000000/1h

# Continuous AMP evaluation monitor scoring every conversation with rule-based
# evaluators (tool use, step success, latency, tokens, iterations): on | off.
AMP_QUALITY_MONITOR=on
AMP_MONITOR_INTERVAL_MINUTES=60
