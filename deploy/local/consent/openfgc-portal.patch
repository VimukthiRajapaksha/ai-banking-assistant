+import { getUserProfile, type UserProfile } from './authClient'
+
+const LABEL_CLAIMS = ['email', 'preferred_username', 'username'] as const
+
+/**
+ * How a user id reads on screen.
+ *
+ * A consent records the user by their identity-provider id (the token `sub`),
+ * which means nothing to the person looking at it. When that id is the
+ * signed-in user's own, show their email or username from the ID token
+ * instead. Anyone else's id is shown as recorded: the portal has no claims
+ * for them.
+ */
+export function getUserLabel(
+  userId: string | undefined,
+  profile: UserProfile | undefined = getUserProfile(),
+): string {
+  if (!userId) {
+    return '-'
+  }
+  if (!profile || profile.sub !== userId) {
+    return userId
+  }
+  const label = LABEL_CLAIMS.map((name) => profile[name]).find(
+    (value): value is string => typeof value === 'string' && value.trim().length > 0,
+  )
+  return label ? label.trim() : userId
+}
