+import { describe, expect, it } from 'vitest'
+import { getUserLabel } from '../utils/userLabel'
+
+describe('getUserLabel', () => {
+  it("shows the signed-in user's email for their own id", () => {
+    expect(
+      getUserLabel('apex-customer', { sub: 'apex-customer', email: 'alex@apexbank.com' }),
+    ).toBe('alex@apexbank.com')
+  })
+
+  it('falls back to the username when there is no email', () => {
+    expect(getUserLabel('apex-customer', { sub: 'apex-customer', username: 'alex' })).toBe('alex')
+  })
+
+  it("shows someone else's id as recorded", () => {
+    expect(getUserLabel('other-user', { sub: 'apex-customer', email: 'alex@apexbank.com' })).toBe(
+      'other-user',
+    )
+  })
+
+  it('shows the id when no one is signed in, and a dash when there is no id', () => {
+    expect(getUserLabel('apex-customer', undefined)).toBe('apex-customer')
+    expect(getUserLabel(undefined, undefined)).toBe('-')
+  })
+})
