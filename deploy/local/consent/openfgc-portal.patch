+import { cleanup, render, screen } from '@testing-library/react'
+import { I18nextProvider } from 'react-i18next'
+import { afterEach, describe, expect, it } from 'vitest'
+import { OxygenTheme, OxygenUIThemeProvider } from '@wso2/oxygen-ui'
+import i18n from '../i18n/i18n'
+import ConsentPaymentDetailsCard from '../features/consent-registry/components/details/ConsentPaymentDetailsCard'
+import type { ConsentDetailAPI } from '../types/consent'
+
+function renderCard(detail: ConsentDetailAPI): void {
+  render(
+    <I18nextProvider i18n={i18n}>
+      <OxygenUIThemeProvider theme={OxygenTheme}>
+        <ConsentPaymentDetailsCard detail={detail} />
+      </OxygenUIThemeProvider>
+    </I18nextProvider>,
+  )
+}
+
+const PAYMENT: ConsentDetailAPI = {
+  id: 'consent-pay',
+  groupId: 'apex-banking',
+  type: 'payment',
+  status: 'ACTIVE',
+  createdTime: 1,
+  updatedTime: 1,
+  purposes: [],
+  attributes: {
+    payee: 'Dana Lee',
+    payeeAccountNumber: '40218834417',
+    payeeBank: 'Meridian Trust',
+    amount: '50.00',
+    currency: 'USD',
+    reference: 'Dinner last night',
+  },
+  authorizations: [
+    {
+      id: 'auth-1',
+      type: 'authorisation',
+      status: 'APPROVED',
+      updatedTime: 1,
+      resources: {
+        accountIds: ['acc-chk-1120'],
+        accounts: [{ id: 'acc-chk-1120', name: 'Everyday Checking', accountNumber: '50318021120' }],
+      },
+    },
+  ],
+}
+
+afterEach(() => {
+  cleanup()
+})
+
+describe('ConsentPaymentDetailsCard', () => {
+  it('shows where a payment comes from, where it goes, how much and why', () => {
+    renderCard(PAYMENT)
+
+    expect(screen.getByText('Payment Details')).toBeInTheDocument()
+    expect(screen.getByText('Everyday Checking')).toBeInTheDocument()
+    expect(screen.getByText('50318021120')).toBeInTheDocument()
+    expect(screen.getByText('Dana Lee · Meridian Trust')).toBeInTheDocument()
+    expect(screen.getByText('40218834417')).toBeInTheDocument()
+    expect(screen.getByText('50.00 USD')).toBeInTheDocument()
+    expect(screen.getByText('Dinner last night')).toBeInTheDocument()
+  })
+
+  it('says the funding account is not chosen until the payment is approved', () => {
+    renderCard({ ...PAYMENT, status: 'CREATED', authorizations: [] })
+
+    expect(screen.getByText('Not yet chosen')).toBeInTheDocument()
+  })
+
+  it('renders nothing for consents that are not payments', () => {
+    renderCard({ ...PAYMENT, type: 'account-information' })
+
+    expect(screen.queryByText('Payment Details')).not.toBeInTheDocument()
+  })
+})
