+import { Box, Card, CardContent, CardHeader, Divider, Typography } from '@wso2/oxygen-ui'
+import { ArrowDownToLine, ArrowUpFromLine, Banknote, FileText } from '@wso2/oxygen-ui-icons-react'
+import { useTranslation } from 'react-i18next'
+import type { ConsentAuthorizationResource, ConsentDetailAPI } from '../../../../types/consent'
+
+interface ConsentPaymentDetailsCardProps {
+  detail: ConsentDetailAPI
+}
+
+interface PaymentAccount {
+  name: string
+  accountNumber: string
+}
+
+interface DetailRowProps {
+  icon: React.ReactNode
+  label: string
+  primary: string
+  secondary?: string
+}
+
+/** The account the payment is drawn from, as recorded with the approval. */
+function getDebtorAccount(
+  authorizations: ConsentAuthorizationResource[] | undefined,
+): PaymentAccount | null {
+  const recorded = (authorizations ?? [])
+    .map(({ resources }) =>
+      resources != null && typeof resources === 'object'
+        ? (resources as { accounts?: unknown }).accounts
+        : undefined,
+    )
+    .find(
+      (accounts): accounts is Partial<PaymentAccount>[] =>
+        Array.isArray(accounts) && accounts.length > 0,
+    )
+  if (!recorded) {
+    return null
+  }
+  const [account] = recorded
+  return { name: account.name ?? '', accountNumber: account.accountNumber ?? '' }
+}
+
+function joinParts(parts: (string | undefined)[]): string {
+  return parts.filter((part) => part != null && part.trim().length > 0).join(' · ')
+}
+
+function DetailRow({ icon, label, primary, secondary }: DetailRowProps): React.JSX.Element {
+  return (
+    <Box>
+      <Typography
+        variant="caption"
+        color="text.secondary"
+        fontWeight={700}
+        sx={{
+          display: 'inline-flex',
+          alignItems: 'center',
+          gap: 0.5,
+          mb: 1,
+          textTransform: 'uppercase',
+          letterSpacing: 0.5,
+        }}
+      >
+        {icon}
+        {label}
+      </Typography>
+      <Typography variant="body2" fontWeight={500}>
+        {primary}
+      </Typography>
+      {secondary ? (
+        <Typography variant="body2" color="text.secondary" sx={{ fontFamily: 'monospace' }}>
+          {secondary}
+        </Typography>
+      ) : null}
+    </Box>
+  )
+}
+
+/**
+ * What a payment consent actually authorises: from where, to whom, how much
+ * and what for. Rendered only for payment consents that carry these details.
+ */
+function ConsentPaymentDetailsCard({
+  detail,
+}: ConsentPaymentDetailsCardProps): React.JSX.Element | null {
+  const { t } = useTranslation('common')
+  const attributes = detail.attributes ?? {}
+  if (detail.type !== 'payment' || !attributes.payee) {
+    return null
+  }
+  const debtor = getDebtorAccount(detail.authorizations)
+  const notRecorded = t('consentRegistry.details.payment.notRecorded', 'Not yet chosen')
+
+  return (
+    <Card sx={{ boxShadow: 1 }}>
+      <CardHeader
+        title={
+          <Typography variant="h6">
+            {t('consentRegistry.details.payment.title', 'Payment Details')}
+          </Typography>
+        }
+        sx={{ pb: 1 }}
+      />
+      <Divider />
+      <CardContent sx={{ pt: 3 }}>
+        <Box
+          sx={{
+            display: 'grid',
+            gridTemplateColumns: { xs: '1fr', sm: '1fr 1fr', lg: 'repeat(4, 1fr)' },
+            gap: { xs: 3, md: 4 },
+          }}
+        >
+          <DetailRow
+            icon={<ArrowUpFromLine size={14} />}
+            label={t('consentRegistry.details.payment.from', 'Pay From')}
+            primary={debtor?.name || notRecorded}
+            secondary={debtor?.accountNumber}
+          />
+          <DetailRow
+            icon={<ArrowDownToLine size={14} />}
+            label={t('consentRegistry.details.payment.to', 'Pay To')}
+            primary={joinParts([attributes.payee, attributes.payeeBank])}
+            secondary={attributes.payeeAccountNumber}
+          />
+          <DetailRow
+            icon={<Banknote size={14} />}
+            label={t('consentRegistry.details.payment.amount', 'Amount')}
+            primary={[attributes.amount, attributes.currency].filter(Boolean).join(' ')}
+          />
+          <DetailRow
+            icon={<FileText size={14} />}
+            label={t('consentRegistry.details.payment.description', 'Description')}
+            primary={attributes.reference || '-'}
+          />
+        </Box>
+      </CardContent>
+    </Card>
+  )
+}
+
+DetailRow.defaultProps = {
+  secondary: undefined,
+}
+
+export default ConsentPaymentDetailsCard
